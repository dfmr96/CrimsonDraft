.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# ─── JetBrains (Rider) ────────────────────────────────────────────────────────
.idea/

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ─── LDtk (editor de niveles) ─────────────────────────────────────────────────
*.ldtk.backup

# ─── Unity — ignorar docs copiados en _Design (se trackean en la raíz) ────────
Game/CrimsonDraft/Assets/_Design/

# ─── Screenshots & Recordings (outputs generados) ─────────────────────────────
Screenshots/
Recordings/
Game/CrimsonDraft/Assets/Screenshots/
Game/CrimsonDraft/Assets/Screenshots.meta

# ─── Git Worktrees ────────────────────────────────────────────────────────────
.worktrees/

# ─── Wwise SDK source zips (large binaries, not versioned) ───────────────────
WwiseUnityIntegration_*.zip

# ─── Claude Code (local/machine-specific config) ──────────────────────────────
# .mcp.json tiene paths de uvx específicos por máquina — cada dev genera el suyo
# con Window → MCP for Unity → Configure All Detected Clients
.mcp.json
# .claude es local excepto commands/ — los slash commands se comparten vía git
.claude/*
!.claude/commands/
# Agentes locales de Claude (configuración por máquina)
.agents/

# ─── Misc ─────────────────────────────────────────────────────────────────────
*.tmp
*.log
logRunSetup.txt
.vscode/
CLAUDE.md
podrias-crearme-un-plan-velvet-creek.md
skills-lock.json

# ─── Wwise Originals (raw source audio, too large for the repo) ───────────────
# Only the compiled SoundBanks in Assets/StreamingAssets are needed at runtime.
Game/CrimsonDraft/CrimsonDraft_WwiseProject/Originals/SFX/WINDDsgn_EXT, Eye Of The Storm_344 Audio_Extreme Winds Vol 1.wav
Game/CrimsonDraft/CrimsonDraft_WwiseProject/Originals/SFX/WINDDsgn_EXT, Eye Of The Storm_344 Audio_Extreme Winds Vol 1.akd
