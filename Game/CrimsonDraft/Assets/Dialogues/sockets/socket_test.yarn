<<declare $activated = false as bool>>
<<declare $slots_filled = 0 as number>>
<<declare $slots_total = 0 as number>>
<<declare $insert_result = "" as string>>
<<if $insert_result == "success">>
{$item_name} inserted. {$slots_filled} of {$slots_total} filled.
<<elseif $insert_result == "wrong_item">>
{$item_name} does not fit here.
<<elseif $activated>>
Already activated.
<<else>>
