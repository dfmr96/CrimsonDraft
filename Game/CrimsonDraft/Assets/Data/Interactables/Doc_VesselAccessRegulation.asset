  m_Script: {fileID: 11500000, guid: 5ca3dc37bc93c41448ec7711e01fface, type: 3}
  m_Name: Doc_VesselAccessRegulation
  m_EditorClassIdentifier: CrimsonDraft.Navigation::CrimsonDraft.Navigation.Interactables.DocumentData
  title: VESSEL ACCESS REGULATION
  pages:
  - "Secured compartments aboard this vessel operate under a color-coded access \nsystem.
    Each locked door is assigned a corresponding key chain identified by the same
    color label displayed on or near the compartment entrance.\n\nAuthorized crew
    are to use only the [important]key chain[/important] matching the compartment\u2019s
    assigned color designation. Key chains are to remain in their posted locations
    when not in use and must not be transferred between sections without authorization.\n\nAdditional
    restrictions may be enforced during emergencies, onboard disturbances, or security
    incidents at the discretion of command.\n\nObserve all compartment safety rules
    without exception."
