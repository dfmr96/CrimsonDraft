/* ── Root ──────────────────────────────────────────────────────── */

.hud-root {
    flex-grow: 1;
    justify-content: flex-end;
}

/* ── Bottom Strip ──────────────────────────────────────────────── */

.bottom-strip {
    flex-direction: row;
    align-items: stretch;
    background-color: rgba(4, 6, 10, 210);
    border-top-color: rgb(45, 55, 65);
    border-top-width: 1px;
    padding: 10px 16px;
    gap: 0;
}

.strip-divider {
    width: 1px;
    background-color: rgb(45, 55, 65);
    margin-left: 16px;
    margin-right: 16px;
}

/* ── Action Panel ──────────────────────────────────────────────── */

.action-panel {
    width: 148px;
    justify-content: center;
    gap: 2px;
}

.action-item {
    flex-direction: row;
    align-items: center;
    padding: 5px 0;
    gap: 6px;
}

.action-selector {
    color: rgb(220, 195, 80);
    font-size: 11px;
    width: 14px;
    -unity-text-align: middle-center;
    visibility: hidden;
}

.action-label {
    color: rgb(170, 175, 185);
    font-size: 13px;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

/* ── Stats Panel ───────────────────────────────────────────────── */

.stats-panel {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    gap: 12px;
}

.portrait {
    width: 52px;
    height: 52px;
    background-color: rgb(22, 28, 36);
    border-color: rgb(55, 65, 78);
    border-width: 1px;
}

.char-info {
    gap: 3px;
    justify-content: center;
}

.char-name {
    color: rgb(160, 200, 230);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.ecg-line {
    color: rgb(40, 210, 110);
    font-size: 10px;
    -unity-text-align: middle-left;
}

.bp-line {
    color: rgb(220, 90, 90);
    font-size: 10px;
    -unity-text-align: middle-left;
}

.weapon-line {
    color: rgb(200, 195, 155);
    font-size: 10px;
    -unity-text-align: middle-left;
}
