.qte-root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.qte-panel {
    width: 320px;
    height: 200px;
    background-color: rgba(10, 10, 10, 230);
    border-color: rgb(180, 20, 20);
    border-width: 2px;
    border-radius: 6px;
    align-items: center;
    justify-content: center;
}

.qte-placeholder {
    color: rgb(180, 180, 180);
    font-size: 16px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
}
