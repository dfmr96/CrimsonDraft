<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="CombatActionMenu.uss" />
    <ui:VisualElement name="root" class="hud-root">
        <ui:VisualElement name="bottom-strip" class="bottom-strip">

            <!-- Action Menu (bottom-left) -->
            <ui:VisualElement name="action-panel" class="action-panel">
                <ui:VisualElement name="action-item-fire" class="action-item">
                    <ui:Label name="selector-fire" text="►" class="action-selector" />
                    <ui:Label text="DISPARAR" class="action-label" />
                </ui:VisualElement>
                <ui:VisualElement name="action-item-close" class="action-item">
                    <ui:Label name="selector-close" text="►" class="action-selector" />
                    <ui:Label text="CERRAR" class="action-label" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="strip-divider" />

            <!-- Character Stats (placeholder) -->
            <ui:VisualElement name="stats-panel" class="stats-panel">
                <ui:VisualElement name="portrait" class="portrait" />
                <ui:VisualElement name="char-info" class="char-info">
                    <ui:Label text="OPERADOR" class="char-name" />
                    <ui:Label text="ECG  ~~~~&#x2227;~~~~  72bpm" class="ecg-line" />
                    <ui:Label text="PA   120 / 80" class="bp-line" />
                    <ui:Label text="P229   13 / 13" class="weapon-line" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
